# Copy to .env.local and fill in locally. Never commit real values.

# FastAPI backend base URL (local: http://localhost:8000)
BACKEND_URL=http://localhost:8000

# Must match the backend's value
BACKEND_SHARED_SECRET=

# Private Cloud Run only: service-account key JSON with run.invoker (server-only; leave empty locally)
GCP_INVOKER_CREDENTIALS=

# Signs httpOnly session cookies (at least 32 random characters, server-only)
SESSION_SECRET=
