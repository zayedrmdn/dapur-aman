# Copy to .env and fill in locally. Never commit real values.

# AI provider: "vertex" (Gemini through Vertex AI) or "openrouter"
AI_PROVIDER=vertex
AI_MODEL=

# Vertex AI (local auth: gcloud auth application-default login)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# OpenRouter, only when AI_PROVIDER=openrouter
OPENROUTER_API_KEY=

# Neon Postgres: pooled for the app, direct for migrations
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Object Storage (S3-compatible, private bucket)
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=food-photos
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Must match the frontend's value
BACKEND_SHARED_SECRET=

# Telegram notifications (bot token from @BotFather; chat that receives alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
